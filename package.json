{
  "name": "lead-delivery-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:workers",
    "build:workers": "tsc -p tsconfig.workers.json",
    "start": "next start",
    "lint": "next lint",
    "workers": "node --max-old-space-size=768 --expose-gc --import tsx src/workers/master.ts",
    "worker:prod": "node --max-old-space-size=768 --expose-gc dist/workers/master.js",
    "worker:standalone": "node --max-old-space-size=768 --expose-gc --import tsx src/workers/standalone.ts",
    "provision-queues": "tsx scripts/provision-queues.ts",
    "test:webhook": "curl -X POST http://localhost:3000/api/ingest-complete -H 'Content-Type: application/json' -H 'x-hook-secret: your-webhook-secret' -d '{\"runId\": \"test-123\", \"ingestedAt\": \"2025-01-01T00:00:00Z\"}'"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.11.1",
    "@types/luxon": "^3.7.1",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.35.8",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.3",
    "bottleneck": "^2.19.5",
    "csv-parse": "^6.0.0",
    "form-data": "^4.0.4",
    "haversine-distance": "^1.2.4",
    "i18n-iso-countries": "^7.14.0",
    "luxon": "^3.7.2",
    "next": "^15.3.4",
    "next-auth": "^4.24.11",
    "node-cron": "^4.2.1",
    "pg-boss": "^12.1.1",
    "prisma": "^6.11.0",
    "rate-limiter-flexible": "^9.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.4",
    "zod": "^3.25.72"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/csv-parse": "^1.1.12",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^20.19.7",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "optionalDependencies": {
    "ioredis": "^5.8.2"
  }
}
